# Salin file ini menjadi .env lalu isi. .env tidak ikut di-commit.

# Nama Anda (dipakai di prompt)
MY_NAME=

# Bahasa yang ditranskrip (en-US, en-GB, en-AU, ...)
TRANSCRIBE_LOCALE=en-US

# Panjang jawaban
ANSWER_MAX_WORDS=40
ANSWER_MAX_SENTENCES=3

# Auto-jawab: jeda (detik) setelah mereka berhenti bicara, dan minimal kata
TURN_END_SECONDS=1.0
AUTO_MIN_WORDS=4

# LLM utama. Kalau belum ada kata pertama dalam LLM_HEDGE_SECONDS, LLM2 ikut jalan; yang duluan menjawab dipakai.
LLM1_LABEL=Qwen aicon
LLM1_URL=https://aicon.air.id
LLM1_KEY=isi-api-key-anda
LLM1_MODEL=Qwen/Qwen3.8-27B
LLM1_EXTRA={"chat_template_kwargs":{"enable_thinking":false},"temperature":0.3}

LLM2_LABEL=Grok Tokenku
LLM2_URL=https://api.tokenku.ai/v1
LLM2_KEY=isi-api-key-anda
LLM2_MODEL=grok-4-1-fast-non-reasoning
LLM2_EXTRA={"temperature":0.3}

LLM_HEDGE_SECONDS=1.5
LLM_MAX_TOKENS=220

# Format jawaban: poin (dilirik, diucapkan sendiri) atau naskah (kalimat lengkap)
ANSWER_STYLE=poin
